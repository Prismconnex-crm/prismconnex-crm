DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

AUTH_SECRET="replace-with-random-secret"

# ContactOut People Search — powers the People page employee-detail panel.
# Credit-metered; looked up on demand per clicked company. Optional: without it
# the panel shows a "not connected" notice instead of employee rows.
CONTACTOUT_API_KEY=""

# Supabase Auth — the active auth provider. The anon key is sufficient: signup,
# the password grant and the OAuth/PKCE endpoints all accept it, and profile
# reads go through Prisma. No service_role key is required.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Must match Supabase -> Authentication -> URL Configuration -> Redirect URLs.
APP_URL="http://localhost:3000"

# AWS Cognito — dormant, superseded by Supabase Auth.
COGNITO_REGION="us-east-1"
COGNITO_USER_POOL_ID="us-east-1_example"
COGNITO_CLIENT_ID="exampleclientid"
COGNITO_CLIENT_SECRET="exampleclientsecret"
COGNITO_DOMAIN="your-domain.auth.us-east-1.amazoncognito.com"
COGNITO_REDIRECT_URI="http://localhost:3000/auth/callback"

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Powers natural-language search on the Companies and Events tabs. Optional:
# without it both fall back to a plain keyword search and say so in the UI.
# Put the real key in .env.local — .env is tracked in this repo.
ANTHROPIC_API_KEY=""
