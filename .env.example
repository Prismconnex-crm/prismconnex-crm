DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

AUTH_SECRET="replace-with-random-secret"

# ContactOut People Search — powers the People page employee-detail panel.

# Credit-metered; looked up on demand per clicked company. Optional: without it
# the panel shows a "not connected" notice instead of employee rows.
CONTACTOUT_API_KEY=""

# Supabase Auth — the active auth provider. The anon key is sufficient: signup,
# the password grant and the OAuth/PKCE endpoints all accept it, and profile
# reads go through Prisma. No service_role key is required.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Must match Supabase -> Authentication -> URL Configuration -> Redirect URLs.
APP_URL="http://localhost:3000"

# Calendar integrations (Integrations -> Calendar). Server-only — never prefix
# these with NEXT_PUBLIC_. Separate from Supabase's Google/Microsoft sign-in,
# which only grants identity; the same Google Cloud / Entra apps can be reused.
# Redirect URIs to register (derived from APP_URL unless overridden below):
#   Google:    <APP_URL>/api/integrations/calendar/callback/google
#   Microsoft: <APP_URL>/api/integrations/calendar/callback/microsoft
# Google Cloud: also enable the "Google Calendar API" for the project, and add
# the scopes .../auth/calendar.events and .../auth/calendar.calendarlist.readonly
# to the OAuth consent screen (while in Testing, add your account as a test user).
# Entra: "Accounts in any organizational directory and personal Microsoft
# accounts" so both Microsoft 365 and Outlook.com work; delegated Graph
# permissions Calendars.ReadWrite, User.Read, offline_access, openid, email.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_CALENDAR_REDIRECT_URI=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_CALENDAR_REDIRECT_URI=""
# Encrypts stored OAuth tokens and webhook signing secrets (AES-256-GCM). Any random string of 32+ chars,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Changing it later forces calendar reconnections and makes stored webhook secrets unusable.
INTEGRATIONS_ENCRYPTION_KEY=""

# AWS Cognito — dormant, superseded by Supabase Auth.
COGNITO_REGION="us-east-1"
COGNITO_USER_POOL_ID="us-east-1_example"
COGNITO_CLIENT_ID="exampleclientid"
COGNITO_CLIENT_SECRET="exampleclientsecret"
COGNITO_DOMAIN="your-domain.auth.us-east-1.amazoncognito.com"
COGNITO_REDIRECT_URI="http://localhost:3000/auth/callback"

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Mapbox publishable token for the event location map
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Powers natural-language search on the Companies and Events tabs. Optional:
# without it both fall back to a plain keyword search and say so in the UI.
# Keep the real key out of git: .env is ignored, use it or .env.local.
ANTHROPIC_API_KEY=""
