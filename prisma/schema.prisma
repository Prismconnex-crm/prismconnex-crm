generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Foundation (user-provided) ───────────────────────────────


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  // Links this CRM/tenancy record to the Supabase Auth user (auth.users.id).
  // Nullable because the seeded demo user predates Supabase Auth and still
  // resolves by email — see resolveTenant() in lib/auth/tenant.ts.
  supabaseUserId String? @unique @db.Uuid

  memberships Membership[]
  tasks       Task[]
}

/// Profile data for a Supabase Auth user. Credentials are NEVER stored here —
/// passwords live only in auth.users.encrypted_password.
///
/// Created by the `on_auth_user_created` trigger on auth.users (see
/// supabase/sql/001_create_profiles.sql), so a row appears for every signup
/// path including Google/Microsoft OAuth.
///
/// ⚠️ In Postgres, `profiles.id` also carries a FOREIGN KEY to auth.users(id)
/// with ON DELETE CASCADE. Prisma 5 cannot model a cross-schema relation
/// without the `multiSchema` preview feature, so that constraint is invisible
/// here and `prisma migrate dev` will report it as drift. Do not "fix" the
/// drift by dropping the constraint.
model Profile {
  id         String   @id @db.Uuid
  firstName  String   @map("first_name")
  middleName String?  @map("middle_name")
  lastName   String   @map("last_name")
  email      String
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone])
  @@map("profiles")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  region    String   @default("EU")
  createdAt DateTime @default(now())

  memberships Membership[]
  settings    WorkspaceSettings?
  events      Event[]
  companies   Company[]
  contacts    Contact[]
  leads       Lead[]
  deals       Deal[]
  sequences   Sequence[]
  tasks       Task[]
  imports     ImportJob[]
  exports     ExportJob[]
  audits      AuditLog[]
  enrollments SequenceEnrollment[]
  emailEvents EmailEvent[]
  savedCompanies SavedCompany[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String     @default("VIEWER")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model WorkspaceSettings {
  workspaceId  String  @id
  locale       String  @default("en-US")
  timeZone     String  @default("Europe/Berlin")
  currency     String  @default("EUR")
  dateFormat   String  @default("DD MMM YYYY")
  timeFormat   String  @default("24h")
  showDualTime Boolean @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entity      String
  entityId    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── CRM Domain Models ───────────────────────────────────────


model Event {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  city        String
  country     String
  startAt     DateTime
  endAt       DateTime
  source      String
  fetchedAt   DateTime
  confidence  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Company {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  category        String?
  description     String?
  domain          String?
  website         String?
  founded         String?
  employeeRange   String?
  headquarters    String?
  region          String?
  revenueRange    String?
  engagementScore Int?     @default(0)
  trustSignals    String?
  tags            String?
  email           String?
  phone           String?
  highlights      String?
  insights        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  leads     Lead[]
  deals     Deal[]

  @@index([name], map: "idx_company_name")
  @@index([category], map: "idx_company_category")
  @@index([employeeRange], map: "idx_company_employee")
  @@index([region], map: "idx_company_region")
  @@index([category, employeeRange, region], map: "idx_company_filters")
  @@index([workspaceId])
}

// Shared company discovery dataset (34.6M rows), migrated off the local-only
// SQLite dev.db so every team member can query it without the 27GB file.
// Unscoped (no workspaceId) — same shared-across-tenants dataset SQLite was.
model DiscoveryCompany {
  rowCursor       BigInt   @id @default(autoincrement())
  id              String   @unique
  name            String
  category        String?
  description     String?
  domain          String?
  website         String?
  founded         String?
  employeeRange   String?
  headquarters    String?
  region          String?
  revenueRange    String?
  engagementScore Int?     @default(0)
  trustSignals    String?
  tags            String?
  email           String?
  phone           String?
  highlights      String?
  insights        String?

  @@index([employeeRange], map: "idx_discovery_employee")
  @@index([region], map: "idx_discovery_region")
  // Progressive filter workflow (Category -> Location -> Country -> Headcount),
  // list ordered by rowCursor DESC. Trailing rowCursor lets the Category(+Location)
  // step be a pre-sorted index scan that stops at LIMIT.
  @@index([category, region, rowCursor(sort: Desc)], map: "idx_discovery_cat_region_cursor")
  // NOTE: an expression index also exists on the extracted country for the
  // Country/Headcount steps — Prisma can't express it, so it lives only in
  // prisma/migrations/20260725_add_discovery_filter_workflow_indexes:
  //   ("category","region",(trim(split_part("headquarters",',',-1))),"employeeRange")
  //   as idx_discovery_cat_region_country_emp
}

// Employee/contact records for a DiscoveryCompany, shown in the People page's
// employee-detail card. Doubles as the enrichment cache: rows can be entered
// manually (verified first-party data) or written once by a provider lookup so
// the same company is never paid for twice. `source` records the origin.
model CompanyContact {
  id          String   @id @default(cuid())
  companyId   String // -> DiscoveryCompany.id
  fullName    String
  jobTitle    String?
  email       String?
  phone       String?
  location    String?
  linkedinUrl String?
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, fullName])
  @@index([companyId])
}

// Bookmarks into the shared SQLite discovery dataset. `snapshot` carries the
// company card data because the discovery DB is a separate (non-relational) source.
model SavedCompany {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  snapshot    Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, companyId])
  @@index([workspaceId])
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String?
  firstName   String
  lastName    String
  email       String?
  title       String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  enrollments SequenceEnrollment[]
}

model Lead {
  id          String     @id @default(cuid())
  workspaceId String
  companyId   String?
  status      String @default("NEW")
  source      String
  score       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal      Deal?
}

model Deal {
  id          String    @id @default(cuid())
  workspaceId String
  companyId   String?
  leadId      String?   @unique
  name        String
  stage       String @default("DISCOVERY")
  amount      Float     @default(0)
  cost        Float     @default(0)
  roi         Float?
  margin      Float?
  closeDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model Sequence {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  dayOffset  Int
  channel    String
  subject    String?
  body       String?
  createdAt  DateTime @default(now())

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  ownerId     String?
  title       String
  dueAt       DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}

model ImportJob {
  id          String   @id @default(cuid())
  workspaceId String
  filename    String
  status      String   @default("queued")
  totalRows   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ExportJob {
  id          String   @id @default(cuid())
  workspaceId String
  filename    String
  status      String   @default("processing")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SequenceEnrollment {
  id          String   @id @default(cuid())
  workspaceId String
  sequenceId  String
  contactId   String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence  Sequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events    EmailEvent[]
}

model EmailEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  enrollmentId String
  status       String    @default("scheduled")
  scheduledAt  DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}
