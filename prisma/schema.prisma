generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Foundation (user-provided) ───────────────────────────────


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  // Links this CRM/tenancy record to the Supabase Auth user (auth.users.id).
  // Nullable because the seeded demo user predates Supabase Auth and still
  // resolves by email — see resolveTenant() in lib/auth/tenant.ts.
  supabaseUserId String? @unique @db.Uuid

  memberships Membership[]
  tasks       Task[]
}

/// Profile data for a Supabase Auth user. Credentials are NEVER stored here —
/// passwords live only in auth.users.encrypted_password.
///
/// Created by the `on_auth_user_created` trigger on auth.users (see
/// supabase/sql/001_create_profiles.sql), so a row appears for every signup
/// path including Google/Microsoft OAuth.
///
/// ⚠️ In Postgres, `profiles.id` also carries a FOREIGN KEY to auth.users(id)
/// with ON DELETE CASCADE. Prisma 5 cannot model a cross-schema relation
/// without the `multiSchema` preview feature, so that constraint is invisible
/// here and `prisma migrate dev` will report it as drift. Do not "fix" the
/// drift by dropping the constraint.
model Profile {
  id         String   @id @db.Uuid
  firstName  String   @map("first_name")
  middleName String?  @map("middle_name")
  lastName   String   @map("last_name")
  email      String
  phone      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ─── Profile page fields (migration 20260815120000) ───────────────
  // Everything below is nullable or defaulted, so existing rows and the
  // on_auth_user_created trigger (which only writes the columns above) keep
  // working untouched.

  /// Public URL of the avatar in the Supabase Storage `avatars` bucket.
  /// Null = render initials. The object itself is at `<user-id>/<file>`;
  /// see lib/supabase/storage.ts.
  avatarUrl String? @map("avatar_url")

  /// Display handle. Unique case-insensitively via a partial expression index
  /// (profiles_username_lower_key) that Prisma cannot express — it lives in the
  /// migration. Nullable because every pre-existing row has none.
  username String?

  alternatePhone String?   @map("alternate_phone")
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  addressLine    String?   @map("address_line")
  city           String?
  state          String?
  country        String?
  postalCode     String?   @map("postal_code")

  employeeId       String?   @map("employee_id")
  department       String?
  designation      String?
  reportingManager String?   @map("reporting_manager")
  team             String?
  joiningDate      DateTime? @map("joining_date") @db.Date
  /// Free-form tags. text[] rather than a join table: skills are display-only
  /// here, never queried or aggregated across users.
  skills           String[]  @default([])

  /// The user's employer, free text rather than a FK to Workspace: a profile's
  /// company is not always the workspace that owns the seat, and the workspace
  /// name is already shown read-only by the Account Information card.
  company String?
  /// Free-form "about me". The 1000-character cap lives in
  /// UpdateProfessionalInfoSchema, where it can return a readable message.
  bio     String?

  /// Absolute URLs including the scheme — UpdateProfessionalInfoSchema prefixes
  /// https:// and rejects any scheme other than http/https, so these can never
  /// hold a bare host (which an <a href> resolves as a relative path) or a
  /// javascript: URL (stored XSS in the anchor the profile card renders).
  website     String?
  linkedinUrl String? @map("linkedin_url")

  /// active | inactive | deleted. Soft-delete only — the auth.users row is
  /// never removed, because hard deletion needs the service_role key which
  /// this project deliberately does not hold (see docs/PROFILE.md).
  accountStatus  String    @default("active") @map("account_status")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Preferences. Defaults intentionally mirror WorkspaceSettings above, so a
  // user who never opens the Preferences card behaves like their workspace.
  language   String @default("en-US")
  timeZone   String @default("Europe/Berlin") @map("time_zone")
  dateFormat String @default("DD MMM YYYY") @map("date_format")
  currency   String @default("EUR")
  /// light | dark | system — mirrors next-themes, which remains the source of
  /// truth in the browser; this column is what makes the choice follow the user
  /// across devices.
  theme      String @default("system")

  notifyEmail       Boolean @default(true) @map("notify_email")
  notifySms         Boolean @default(false) @map("notify_sms")
  notifyPush        Boolean @default(true) @map("notify_push")
  notifyNewLead     Boolean @default(true) @map("notify_new_lead")
  notifyNewCustomer Boolean @default(true) @map("notify_new_customer")
  notifyDeal        Boolean @default(true) @map("notify_deal")
  notifyTask        Boolean @default(true) @map("notify_task")
  notifySystem      Boolean @default(true) @map("notify_system")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phone])
  @@map("profiles")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  region    String   @default("EU")
  createdAt DateTime @default(now())

  memberships Membership[]
  settings    WorkspaceSettings?
  events      Event[]
  companies   Company[]
  contacts    Contact[]
  leads       Lead[]
  deals       Deal[]
  sequences   Sequence[]
  tasks       Task[]
  imports     ImportJob[]
  exports     ExportJob[]
  audits      AuditLog[]
  enrollments SequenceEnrollment[]
  emailEvents EmailEvent[]
  savedCompanies SavedCompany[]
  credit         WorkspaceCredit?
  creditUsage    CreditUsageEntry[]
  referrals      Referral[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String     @default("VIEWER")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model WorkspaceSettings {
  workspaceId  String  @id
  locale       String  @default("en-US")
  timeZone     String  @default("Europe/Berlin")
  currency     String  @default("EUR")
  dateFormat   String  @default("DD MMM YYYY")
  timeFormat   String  @default("24h")
  showDualTime Boolean @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

// ─── Billing / Credits ───────────────────────────────────────
//
// There is no payment provider wired up, so these tables are the ONLY source of
// truth for a workspace's plan and credit balance. They are deliberately real
// rows rather than a hardcoded UI figure: "remaining credits" is meaningless
// unless both the allowance and the consumption are persisted and can move.
//
// Consumption is written by the metered call sites (currently the ContactOut
// people lookup in app/api/people/route.ts, which is the one genuinely
// credit-metered operation in the app). Nothing backfills historical usage —
// a workspace that has run no lookups shows zero used, because that is true.

/// A workspace's plan and its credit allowance for the current period.
model WorkspaceCredit {
  workspaceId String   @id
  /// STARTER | PROFESSIONAL | ENTERPRISE — matches the public pricing page.
  plan        String   @default("STARTER")
  /// Credits granted for the current period. Consumption is summed from
  /// CreditUsageEntry rather than decremented here, so the ledger stays
  /// auditable and a period reset is a date change, not a destructive update.
  allowance   Int      @default(1000)
  periodStart DateTime @default(now())
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// One metered operation. Append-only.
model CreditUsageEntry {
  id          String   @id @default(cuid())
  workspaceId String
  /// The CRM User.id that triggered it, when attributable.
  userId      String?
  /// PEOPLE_LOOKUP | COMPANY_EXPORT | AI_QUERY — see CREDIT_KINDS.
  kind        String
  amount      Int      @default(1)
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/// An invitation raised from the Profile page's "Refer a New User" card.
///
/// No email is sent — the app has no mail transport and no Supabase
/// service_role key. The row plus its token is what makes the invite link
/// shareable and its acceptance verifiable later.
model Referral {
  id              String    @id @default(cuid())
  workspaceId     String
  /// CRM User.id of the referrer.
  invitedByUserId String
  email           String
  /// Opaque value carried in the invite link as ?ref=.
  token           String    @unique
  /// PENDING | ACCEPTED | REVOKED
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entity      String
  entityId    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── CRM Domain Models ───────────────────────────────────────


model Event {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  city        String
  country     String
  startAt     DateTime
  endAt       DateTime
  source      String
  fetchedAt   DateTime
  confidence  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Company {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  category        String?
  description     String?
  domain          String?
  website         String?
  founded         String?
  employeeRange   String?
  headquarters    String?
  region          String?
  revenueRange    String?
  engagementScore Int?     @default(0)
  trustSignals    String?
  tags            String?
  email           String?
  phone           String?
  highlights      String?
  insights        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  Contact[]
  leads     Lead[]
  deals     Deal[]

  @@index([name], map: "idx_company_name")
  @@index([category], map: "idx_company_category")
  @@index([employeeRange], map: "idx_company_employee")
  @@index([region], map: "idx_company_region")
  @@index([category, employeeRange, region], map: "idx_company_filters")
  @@index([workspaceId])
  // NOTE: an expression index on the lowercased domain also exists, for the
  // sign-up company auto-detection lookup in /api/companies/by-domain. Prisma
  // can't express lower(domain), so it lives only in the migration
  // prisma/migrations/20260805000000_add_company_domain_index:
  //   (lower("domain"), "createdAt") as idx_company_domain_lower
  // The matching indexes on DiscoveryCompany and CompanyContact are in
  // prisma/migrations/20260804000000_add_discovery_domain_index.
}

// Shared company discovery dataset (34.6M rows), migrated off the local-only
// SQLite dev.db so every team member can query it without the 27GB file.
// Unscoped (no workspaceId) — same shared-across-tenants dataset SQLite was.
model DiscoveryCompany {
  rowCursor       BigInt   @id @default(autoincrement())
  id              String   @unique
  name            String
  category        String?
  description     String?
  domain          String?
  website         String?
  founded         String?
  employeeRange   String?
  headquarters    String?
  region          String?
  revenueRange    String?
  engagementScore Int?     @default(0)
  trustSignals    String?
  tags            String?
  email           String?
  phone           String?
  highlights      String?
  insights        String?

  @@index([employeeRange], map: "idx_discovery_employee")
  @@index([region], map: "idx_discovery_region")
  // Progressive filter workflow (Category -> Location -> Country -> Headcount),
  // list ordered by rowCursor DESC. Trailing rowCursor lets the Category(+Location)
  // step be a pre-sorted index scan that stops at LIMIT.
  @@index([category, region, rowCursor(sort: Desc)], map: "idx_discovery_cat_region_cursor")
  // NOTE: an expression index also exists on the extracted country for the
  // Country/Headcount steps — Prisma can't express it, so it lives only in
  // prisma/migrations/20260725_add_discovery_filter_workflow_indexes:
  //   ("category","region",(trim(split_part("headquarters",',',-1))),"employeeRange")
  //   as idx_discovery_cat_region_country_emp
}

// Exhibitors imported from an event's public exhibitor directory.
//
// Company-level fields come from the source listing. The personal-contact fields
// are deliberately nullable: exhibitor directories almost never publish named
// contacts, and these must only ever be filled from a source that legitimately
// provides them.
model EventExhibitor {
  id        String @id @default(cuid())
  /// FindShowEvent.slug this exhibitor belongs to.
  eventSlug String

  companyName String
  /// Canonical form of companyName (see scripts/lib/exhibitor-name-key.mjs).
  /// Used to match enrichment sources onto a listing; NOT unique, because a
  /// directory legitimately lists one company twice on different stands.
  nameKey     String?
  logoUrl     String?
  /// Source directory page for this exhibitor - also the upsert key.
  sourceDetailUrl   String
  /// Root directory page for the event, used as the link fallback when an
  /// exhibitor publishes no official website of its own.
  sourceDirectoryUrl String?
  websiteUrl        String?
  standNumber       String?
  country           String?
  phone             String?
  companyLinkedInUrl String?
  description       String?
  categories        String[] @default([])

  // Personal contact — nullable, never inferred.
  firstName         String?
  lastName          String?
  designation       String?
  email             String?
  personLinkedInUrl String?

  /// Where the row came from, e.g. bettshow.com
  source    String   @default("import")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventSlug, sourceDetailUrl])
  @@index([eventSlug])
  @@index([eventSlug, companyName])
  @@index([eventSlug, nameKey])
}

// Employee/contact records for a DiscoveryCompany, shown in the People page's
// employee-detail card. Doubles as the enrichment cache: rows can be entered
// manually (verified first-party data) or written once by a provider lookup so
// the same company is never paid for twice. `source` records the origin.
model CompanyContact {
  id          String   @id @default(cuid())
  companyId   String // -> DiscoveryCompany.id
  fullName    String
  jobTitle    String?
  email       String?
  phone       String?
  location    String?
  linkedinUrl String?
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, fullName])
  @@index([companyId])
}

// Bookmarks into the shared SQLite discovery dataset. `snapshot` carries the
// company card data because the discovery DB is a separate (non-relational) source.
model SavedCompany {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  snapshot    Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, companyId])
  @@index([workspaceId])
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String?
  firstName   String
  lastName    String
  email       String?
  title       String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  enrollments SequenceEnrollment[]
}

model Lead {
  id          String     @id @default(cuid())
  workspaceId String
  companyId   String?
  status      String @default("NEW")
  source      String
  score       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deal      Deal?
}

model Deal {
  id          String    @id @default(cuid())
  workspaceId String
  companyId   String?
  leadId      String?   @unique
  name        String
  stage       String @default("DISCOVERY")
  amount      Float     @default(0)
  cost        Float     @default(0)
  roi         Float?
  margin      Float?
  closeDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model Sequence {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  dayOffset  Int
  channel    String
  subject    String?
  body       String?
  createdAt  DateTime @default(now())

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  ownerId     String?
  title       String
  dueAt       DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
}

model ImportJob {
  id          String   @id @default(cuid())
  workspaceId String
  filename    String
  status      String   @default("queued")
  totalRows   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ExportJob {
  id          String   @id @default(cuid())
  workspaceId String
  filename    String
  status      String   @default("processing")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SequenceEnrollment {
  id          String   @id @default(cuid())
  workspaceId String
  sequenceId  String
  contactId   String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence  Sequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events    EmailEvent[]
}

model EmailEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  enrollmentId String
  status       String    @default("scheduled")
  scheduledAt  DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollment SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}
